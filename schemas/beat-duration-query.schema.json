{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "startBeat": {
      "type": "object",
      "properties": {
        "numerator": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "denominator": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      },
      "required": [
        "numerator",
        "denominator"
      ],
      "additionalProperties": false
    },
    "durationSeconds": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "startBeat",
    "durationSeconds"
  ],
  "additionalProperties": false
}
