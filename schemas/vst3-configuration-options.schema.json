{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sampleRate": {
      "default": 48000,
      "type": "integer",
      "minimum": 8000,
      "maximum": 192000
    },
    "blockSize": {
      "default": 128,
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "configuration": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "number",
          "const": 1
        },
        "classId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stateBase64": {
          "type": "string",
          "maxLength": 5592408,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,9})$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "formatVersion",
        "classId",
        "sha256",
        "stateBase64",
        "parameters"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,9})$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    }
  },
  "required": [
    "sampleRate",
    "blockSize",
    "parameters"
  ],
  "additionalProperties": false
}
