{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "string"
    },
    "pluginId": {
      "type": "string"
    },
    "pluginVersion": {
      "type": "string"
    },
    "abiMajor": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "instrument",
        "effect"
      ]
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "normalized",
              "db",
              "hz",
              "semitones",
              "seconds",
              "beats",
              "enum"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "default": {
            "type": "number"
          },
          "smoothing": {
            "type": "string",
            "enum": [
              "none",
              "linear",
              "one-pole"
            ]
          },
          "rate": {
            "type": "string",
            "enum": [
              "control",
              "audio"
            ]
          },
          "automation": {
            "type": "boolean"
          },
          "mapping": {
            "type": "string",
            "enum": [
              "linear",
              "log",
              "bipolar",
              "enum"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "unit",
          "min",
          "max",
          "default",
          "smoothing",
          "rate"
        ],
        "additionalProperties": false
      }
    },
    "stateSchema": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "protocolVersion",
    "pluginId",
    "pluginVersion",
    "abiMajor",
    "kind",
    "parameters",
    "stateSchema"
  ],
  "additionalProperties": false
}
