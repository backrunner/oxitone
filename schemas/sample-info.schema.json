{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "format": {
      "type": "string",
      "enum": [
        "wav",
        "aiff",
        "flac",
        "mp3",
        "mp4",
        "m4a"
      ]
    },
    "sampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "channels": {
      "anyOf": [
        {
          "type": "number",
          "const": 1
        },
        {
          "type": "number",
          "const": 2
        }
      ]
    },
    "frames": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d{0,19})$"
    },
    "protocolVersion": {
      "type": "string"
    },
    "sourceChannels": {
      "type": "integer",
      "minimum": 1,
      "maximum": 255
    },
    "sourceBitDepth": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "decoder": {
      "type": "string",
      "minLength": 1
    },
    "channelLayoutAction": {
      "type": "string",
      "enum": [
        "kept",
        "downmixed-to-stereo"
      ]
    }
  },
  "required": [
    "sha256",
    "format",
    "sampleRate",
    "channels",
    "frames",
    "protocolVersion",
    "sourceChannels",
    "decoder",
    "channelLayoutAction"
  ],
  "additionalProperties": false
}
