{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "bundlePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "expectedHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "allowPlugins": {
      "default": "signed-only",
      "type": "string",
      "enum": [
        "signed-only",
        "any"
      ]
    }
  },
  "required": [
    "bundlePath",
    "allowPlugins"
  ],
  "additionalProperties": false
}
