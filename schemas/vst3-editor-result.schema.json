{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "accepted": {
          "type": "boolean",
          "const": false
        }
      },
      "required": [
        "protocolVersion",
        "accepted"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "number",
          "const": 1
        },
        "accepted": {
          "type": "boolean",
          "const": true
        },
        "info": {
          "type": "object",
          "properties": {
            "protocolVersion": {
              "type": "number",
              "const": 1
            },
            "classId": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{32}$"
            },
            "name": {
              "type": "string"
            },
            "vendor": {
              "type": "string"
            },
            "version": {
              "type": "string"
            },
            "category": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "inputChannels": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "outputChannels": {
              "type": "integer",
              "minimum": 0,
              "maximum": 2
            },
            "audioBuses": {
              "type": "object",
              "properties": {
                "inputs": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "channels": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2
                      },
                      "active": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "channels",
                      "active"
                    ],
                    "additionalProperties": false
                  }
                },
                "outputs": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "channels": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 2
                      },
                      "active": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "channels",
                      "active"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "inputs",
                "outputs"
              ],
              "additionalProperties": false
            },
            "noteInput": {
              "type": "boolean"
            },
            "noteOutput": {
              "type": "boolean"
            },
            "parameters": {
              "maxItems": 4096,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 4294967295
                  },
                  "name": {
                    "type": "string"
                  },
                  "unit": {
                    "type": "string"
                  },
                  "value": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "default": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "stepCount": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "canAutomate": {
                    "type": "boolean"
                  },
                  "readOnly": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "id",
                  "name",
                  "unit",
                  "value",
                  "default",
                  "stepCount",
                  "canAutomate",
                  "readOnly"
                ],
                "additionalProperties": false
              }
            },
            "configuration": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "formatVersion": {
                      "type": "number",
                      "const": 1
                    },
                    "classId": {
                      "type": "string",
                      "pattern": "^[a-fA-F0-9]{32}$"
                    },
                    "sha256": {
                      "type": "string",
                      "pattern": "^[a-f0-9]{64}$"
                    },
                    "stateBase64": {
                      "type": "string",
                      "maxLength": 5592408,
                      "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
                    },
                    "parameters": {
                      "type": "object",
                      "propertyNames": {
                        "type": "string",
                        "pattern": "^(0|[1-9][0-9]{0,9})$"
                      },
                      "additionalProperties": {
                        "type": "number",
                        "minimum": 0,
                        "maximum": 1
                      }
                    }
                  },
                  "required": [
                    "formatVersion",
                    "classId",
                    "sha256",
                    "stateBase64",
                    "parameters"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "protocolVersion",
            "classId",
            "name",
            "vendor",
            "version",
            "category",
            "sha256",
            "inputChannels",
            "outputChannels",
            "audioBuses",
            "noteInput",
            "noteOutput",
            "parameters",
            "configuration"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "protocolVersion",
        "accepted",
        "info"
      ],
      "additionalProperties": false
    }
  ]
}
