{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "const": "1.0"
        },
        "type": {
          "type": "string",
          "const": "state"
        },
        "revision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d{0,19})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "seenRevision": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(0|[1-9]\\d{0,19})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "cursor": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,19})$"
        },
        "audibleFrame": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d{0,19})$"
        },
        "playing": {
          "type": "boolean"
        },
        "xruns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pluginFaults": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "tracks": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "patterns": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "revision",
        "seenRevision",
        "cursor",
        "audibleFrame",
        "playing",
        "xruns",
        "pluginFaults",
        "tracks",
        "patterns"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "protocolVersion": {
          "type": "string",
          "const": "1.0"
        },
        "type": {
          "type": "string",
          "const": "rejected"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "protocolVersion",
        "type",
        "code",
        "message"
      ],
      "additionalProperties": false
    }
  ]
}
