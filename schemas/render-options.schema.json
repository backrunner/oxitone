{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "bar": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "bar"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "beat": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "beat"
          ],
          "additionalProperties": false
        },
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "seconds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "frames": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,19})$"
                }
              },
              "required": [
                "frames"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "marker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "marker"
          ],
          "additionalProperties": false
        }
      ]
    },
    "end": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "bar": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "bar"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "beat": {
              "type": "object",
              "properties": {
                "numerator": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "denominator": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 4294967295
                }
              },
              "required": [
                "numerator",
                "denominator"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "beat"
          ],
          "additionalProperties": false
        },
        {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "seconds": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "seconds"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "frames": {
                  "type": "string",
                  "pattern": "^(0|[1-9]\\d{0,19})$"
                }
              },
              "required": [
                "frames"
              ],
              "additionalProperties": false
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "marker": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_-]+$"
            }
          },
          "required": [
            "marker"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blockSize": {
      "anyOf": [
        {
          "type": "number",
          "const": 64
        },
        {
          "type": "number",
          "const": 128
        },
        {
          "type": "number",
          "const": 256
        }
      ]
    },
    "tailSeconds": {
      "type": "number",
      "minimum": 0
    },
    "respectSolo": {
      "type": "boolean"
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "bitDepth": {
      "anyOf": [
        {
          "type": "number",
          "const": 16
        },
        {
          "type": "number",
          "const": 24
        },
        {
          "type": "string",
          "const": "float32"
        }
      ]
    },
    "dither": {
      "type": "string",
      "enum": [
        "tpdf",
        "none"
      ]
    },
    "stems": {
      "type": "string",
      "enum": [
        "none",
        "mixer-channels",
        "tracks"
      ]
    },
    "includeMetronome": {
      "type": "boolean"
    },
    "assetBaseDir": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "path"
  ],
  "additionalProperties": false
}
