{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "graphGeneration": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "instanceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "instanceControlVersion": {
      "type": "number",
      "const": 1
    },
    "command": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "startEdits"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "touch",
                "write"
              ]
            },
            "parameterIds": {
              "minItems": 1,
              "maxItems": 32,
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              }
            },
            "kind": {
              "type": "string",
              "const": "startRecording"
            }
          },
          "required": [
            "mode",
            "parameterIds",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "readEdits"
            },
            "captureId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "fromSequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "captureId",
            "fromSequence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "stopEdits"
            },
            "captureId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            },
            "fromSequence": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "kind",
            "captureId",
            "fromSequence"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "discardEdits"
            },
            "captureId": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,19}$"
            }
          },
          "required": [
            "kind",
            "captureId"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "openEditor"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "closeEditor"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "poll"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "capture"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "setParameter"
            },
            "parameterId": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            "value": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "kind",
            "parameterId",
            "value"
          ],
          "additionalProperties": false
        }
      ]
    },
    "timeoutMs": {
      "default": 5000,
      "type": "integer",
      "minimum": 1,
      "maximum": 600000
    }
  },
  "required": [
    "graphGeneration",
    "instanceId",
    "instanceControlVersion",
    "command",
    "timeoutMs"
  ],
  "additionalProperties": false
}
