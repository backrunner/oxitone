{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sampleId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "slices": {
      "anyOf": [
        {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "frames": {
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d{0,19})$"
                      }
                    },
                    "required": [
                      "frames"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "beat": {
                        "type": "object",
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "beat"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "end": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "frames": {
                        "type": "string",
                        "pattern": "^(0|[1-9]\\d{0,19})$"
                      }
                    },
                    "required": [
                      "frames"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "beat": {
                        "type": "object",
                        "properties": {
                          "numerator": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "denominator": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 4294967295
                          }
                        },
                        "required": [
                          "numerator",
                          "denominator"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "required": [
                      "beat"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "level": {
                "type": "number",
                "minimum": 0,
                "maximum": 2
              },
              "pan": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              },
              "rate": {
                "type": "number",
                "minimum": 0.25,
                "maximum": 4
              },
              "reverse": {
                "type": "boolean"
              }
            },
            "required": [
              "start"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "object",
          "properties": {
            "grid": {
              "type": "integer",
              "minimum": 1,
              "maximum": 64
            }
          },
          "required": [
            "grid"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "onset": {
              "type": "object",
              "properties": {
                "algorithm": {
                  "type": "string",
                  "const": "onset-v1"
                },
                "sensitivity": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 1
                }
              },
              "required": [
                "algorithm"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "onset"
          ],
          "additionalProperties": false
        }
      ]
    },
    "triggerNote": {
      "type": "integer",
      "minimum": 0,
      "maximum": 127
    },
    "playMode": {
      "type": "string",
      "enum": [
        "oneshot",
        "gate"
      ]
    },
    "tempoSync": {
      "type": "string",
      "enum": [
        "off",
        "repitch"
      ]
    }
  },
  "required": [
    "sampleId",
    "slices",
    "playMode"
  ],
  "additionalProperties": false
}
