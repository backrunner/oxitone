{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "protocolVersion": {
      "type": "number",
      "const": 1
    },
    "bundlePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "vendor": {
      "type": "string"
    },
    "classes": {
      "maxItems": 1024,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "classId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{32}$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "const": "Audio Module Class"
          },
          "version": {
            "type": "string"
          }
        },
        "required": [
          "classId",
          "name",
          "category",
          "version"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocolVersion",
    "bundlePath",
    "sha256",
    "vendor",
    "classes"
  ],
  "additionalProperties": false
}
