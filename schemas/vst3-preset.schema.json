{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "formatVersion": {
      "type": "number",
      "const": 1
    },
    "kind": {
      "type": "string",
      "const": "oxitone-vst3-preset"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "source": {
      "type": "object",
      "properties": {
        "bundlePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "classId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        }
      },
      "required": [
        "bundlePath",
        "classId"
      ],
      "additionalProperties": false
    },
    "configuration": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "number",
          "const": 1
        },
        "classId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stateBase64": {
          "type": "string",
          "maxLength": 5592408,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,9})$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "formatVersion",
        "classId",
        "sha256",
        "stateBase64",
        "parameters"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "formatVersion",
    "kind",
    "name",
    "source",
    "configuration"
  ],
  "additionalProperties": false
}
