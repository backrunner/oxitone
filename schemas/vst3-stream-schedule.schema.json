{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scheduleVersion": {
      "type": "number",
      "const": 1
    },
    "epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "latencyBlocks": {
      "type": "integer",
      "minimum": 2,
      "maximum": 16
    }
  },
  "required": [
    "scheduleVersion",
    "epoch",
    "latencyBlocks"
  ],
  "additionalProperties": false
}
