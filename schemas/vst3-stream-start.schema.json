{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "streamProtocolVersion": {
      "type": "number",
      "const": 11
    },
    "source": {
      "type": "object",
      "properties": {
        "bundlePath": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "classId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        },
        "expectedHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "allowPlugins": {
          "default": "signed-only",
          "type": "string",
          "enum": [
            "signed-only",
            "any"
          ]
        }
      },
      "required": [
        "bundlePath",
        "classId",
        "allowPlugins"
      ],
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "sampleRate": {
          "default": 48000,
          "type": "integer",
          "minimum": 8000,
          "maximum": 192000
        },
        "blockSize": {
          "default": 128,
          "type": "integer",
          "minimum": 16,
          "maximum": 4096
        },
        "configuration": {
          "type": "object",
          "properties": {
            "formatVersion": {
              "type": "number",
              "const": 1
            },
            "classId": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{32}$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "stateBase64": {
              "type": "string",
              "maxLength": 5592408,
              "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
            },
            "parameters": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]{0,9})$"
              },
              "additionalProperties": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "required": [
            "formatVersion",
            "classId",
            "sha256",
            "stateBase64",
            "parameters"
          ],
          "additionalProperties": false
        },
        "parameters": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,9})$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "tempo": {
          "default": 120,
          "type": "number",
          "minimum": 20,
          "maximum": 999
        },
        "timeSignature": {
          "default": [
            4,
            4
          ],
          "type": "array",
          "prefixItems": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            },
            {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                },
                {
                  "type": "number",
                  "const": 4
                },
                {
                  "type": "number",
                  "const": 8
                },
                {
                  "type": "number",
                  "const": 16
                }
              ]
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "processingMode": {
          "default": "realtime",
          "type": "string",
          "enum": [
            "realtime",
            "offline"
          ]
        },
        "transport": {
          "type": "object",
          "properties": {
            "projectFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254736895
            },
            "continuousFrame": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254736895
            },
            "projectBeat": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "barBeat": {
              "type": "number",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "tempo": {
              "type": "number",
              "minimum": 20,
              "maximum": 999
            },
            "timeSignature": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 32
                },
                {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 2
                    },
                    {
                      "type": "number",
                      "const": 4
                    },
                    {
                      "type": "number",
                      "const": 8
                    },
                    {
                      "type": "number",
                      "const": 16
                    }
                  ]
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            },
            "playing": {
              "type": "boolean"
            },
            "cycle": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number",
                  "minimum": 0
                },
                {
                  "type": "number",
                  "minimum": 0
                }
              ],
              "items": false,
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "projectFrame",
            "continuousFrame",
            "projectBeat",
            "barBeat",
            "tempo",
            "timeSignature",
            "playing"
          ],
          "additionalProperties": false
        },
        "busActivation": {
          "type": "object",
          "properties": {
            "inputs": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "boolean"
              }
            },
            "outputs": {
              "maxItems": 16,
              "type": "array",
              "items": {
                "type": "boolean"
              }
            }
          },
          "required": [
            "inputs",
            "outputs"
          ],
          "additionalProperties": false
        },
        "midiOutput": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "sampleRate",
        "blockSize",
        "parameters",
        "tempo",
        "timeSignature",
        "processingMode",
        "midiOutput"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "streamProtocolVersion",
    "source",
    "options"
  ],
  "additionalProperties": false
}
