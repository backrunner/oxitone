{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "sampleRate": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "blockSize": {
      "anyOf": [
        {
          "type": "number",
          "const": 64
        },
        {
          "type": "number",
          "const": 128
        },
        {
          "type": "number",
          "const": 256
        }
      ]
    },
    "renderAheadBlocks": {
      "type": "integer",
      "minimum": 2,
      "maximum": 16
    },
    "latencyMode": {
      "type": "string",
      "enum": [
        "buffered",
        "direct"
      ]
    },
    "allowPlugins": {
      "type": "string",
      "enum": [
        "signed-only",
        "any"
      ]
    },
    "outputDeviceId": {
      "type": "string"
    },
    "audioBackend": {
      "type": "string",
      "enum": [
        "device",
        "simulated"
      ]
    },
    "deviceRatePolicy": {
      "type": "string",
      "enum": [
        "adapt-device",
        "resample"
      ]
    },
    "deviceChangePolicy": {
      "type": "string",
      "enum": [
        "follow-default",
        "pause"
      ]
    },
    "metronome": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "enabled"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
