{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "registrationVersion": {
      "type": "number",
      "const": 1
    },
    "pluginId": {
      "type": "string",
      "pattern": "^vst3\\.[a-f0-9]{32}$"
    },
    "pluginVersion": {
      "type": "string",
      "pattern": "^0\\.0\\.0\\+[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "instrument",
        "effect"
      ]
    },
    "parameters": {
      "maxItems": 4096,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "unit": {
            "type": "string",
            "enum": [
              "normalized",
              "db",
              "hz",
              "semitones",
              "seconds",
              "beats",
              "enum"
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "default": {
            "type": "number"
          },
          "smoothing": {
            "type": "string",
            "enum": [
              "none",
              "linear",
              "one-pole"
            ]
          },
          "rate": {
            "type": "string",
            "enum": [
              "control",
              "audio"
            ]
          },
          "automation": {
            "type": "boolean"
          },
          "mapping": {
            "type": "string",
            "enum": [
              "linear",
              "log",
              "bipolar",
              "enum"
            ]
          }
        },
        "required": [
          "id",
          "label",
          "unit",
          "min",
          "max",
          "default",
          "smoothing",
          "rate"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "registrationVersion",
    "pluginId",
    "pluginVersion",
    "sha256",
    "kind",
    "parameters"
  ],
  "additionalProperties": false
}
