{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "instanceControlVersion": {
      "type": "number",
      "const": 1
    },
    "graphGeneration": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,19}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "prepared",
        "active",
        "retired"
      ]
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instanceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "pluginId": {
            "type": "string",
            "minLength": 1
          },
          "pluginVersion": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "instanceId",
          "pluginId",
          "pluginVersion"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "instanceControlVersion",
    "graphGeneration",
    "state",
    "instances"
  ],
  "additionalProperties": false
}
