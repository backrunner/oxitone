{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sampleRate": {
      "default": 48000,
      "type": "integer",
      "minimum": 8000,
      "maximum": 192000
    },
    "blockSize": {
      "default": 128,
      "type": "integer",
      "minimum": 16,
      "maximum": 4096
    },
    "frames": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 536000000
    },
    "tailFrames": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 11520000
    },
    "inputPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "configuration": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "number",
          "const": 1
        },
        "classId": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{32}$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "stateBase64": {
          "type": "string",
          "maxLength": 5592408,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "parameters": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]{0,9})$"
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "formatVersion",
        "classId",
        "sha256",
        "stateBase64",
        "parameters"
      ],
      "additionalProperties": false
    },
    "parameters": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,9})$"
      },
      "additionalProperties": {
        "type": "number",
        "minimum": 0,
        "maximum": 1
      }
    },
    "events": {
      "default": [],
      "maxItems": 100000,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "sysEx"
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536000000
              },
              "data": {
                "minItems": 2,
                "maxItems": 4096,
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                }
              }
            },
            "required": [
              "type",
              "frame",
              "data"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "midi"
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536000000
              },
              "message": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "integer",
                    "minimum": 128,
                    "maximum": 239
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  },
                  {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 127
                  }
                ],
                "items": false,
                "minItems": 3,
                "maxItems": 3
              }
            },
            "required": [
              "type",
              "frame",
              "message"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "const": "parameter"
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536000000
              },
              "parameterId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 4294967295
              },
              "value": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "type",
              "frame",
              "parameterId",
              "value"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "noteOn",
                  "noteOff"
                ]
              },
              "frame": {
                "type": "integer",
                "minimum": 0,
                "maximum": 536000000
              },
              "channel": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "pitch": {
                "type": "integer",
                "minimum": 0,
                "maximum": 127
              },
              "velocity": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            },
            "required": [
              "type",
              "frame",
              "channel",
              "pitch",
              "velocity"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "tempo": {
      "default": 120,
      "type": "number",
      "minimum": 20,
      "maximum": 999
    },
    "timeSignature": {
      "default": [
        4,
        4
      ],
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 8
            },
            {
              "type": "number",
              "const": 16
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "path",
    "sampleRate",
    "blockSize",
    "frames",
    "tailFrames",
    "parameters",
    "events",
    "tempo",
    "timeSignature"
  ],
  "additionalProperties": false
}
