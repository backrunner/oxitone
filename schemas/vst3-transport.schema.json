{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectFrame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254736895
    },
    "continuousFrame": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254736895
    },
    "projectBeat": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "barBeat": {
      "type": "number",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "tempo": {
      "type": "number",
      "minimum": 20,
      "maximum": 999
    },
    "timeSignature": {
      "type": "array",
      "prefixItems": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            },
            {
              "type": "number",
              "const": 4
            },
            {
              "type": "number",
              "const": 8
            },
            {
              "type": "number",
              "const": 16
            }
          ]
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "playing": {
      "type": "boolean"
    },
    "cycle": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": 0
        },
        {
          "type": "number",
          "minimum": 0
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "required": [
    "projectFrame",
    "continuousFrame",
    "projectBeat",
    "barBeat",
    "tempo",
    "timeSignature",
    "playing"
  ],
  "additionalProperties": false
}
