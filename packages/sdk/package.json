{
  "name": "oxitone",
  "version": "0.1.0",
  "description": "TypeScript music authoring SDK with a native Rust audio engine",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "vite build",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
