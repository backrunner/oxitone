{
  "name": "@oxitone/core",
  "version": "0.1.0",
  "description": "TypeScript authoring domain model for Oxitone projects",
  "license": "MPL-2.0",
  "type": "module",
  "imports": {
    "#platform-path": { "browser": "./dist/browser/path.js", "default": "./dist/platform-path.js" },
    "#project-files": { "browser": "./dist/browser/project-files.js", "default": "./dist/project-files.js" },
    "#preset-files": { "browser": "./dist/browser/preset-files.js", "default": "./dist/preset-files.js" }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --testTimeout=30000"
  },
  "dependencies": {
    "@oxitone/protocol": "workspace:*",
    "@oxitone/native": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
