{
  "name": "@oxitone/cli",
  "version": "0.1.0",
  "description": "Command line tools for Oxitone rendering and diagnostics",
  "license": "MPL-2.0",
  "type": "module",
  "bin": { "oxitone": "dist/index.js" },
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" },
    "./source": { "types": "./dist/source/index.d.ts", "import": "./dist/source/index.js" },
    "./editor": { "types": "./dist/editor/index.d.ts", "import": "./dist/editor/index.js" }
  },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --testTimeout=30000"
  },
  "dependencies": {
    "typescript": "^5.7.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "@oxitone/core": "workspace:*",
    "@oxitone/protocol": "workspace:*",
    "@oxitone/native": "workspace:*"
  },
  "devDependencies": { "vitest": "^3.2.0" }
}
