{
  "name": "@oxitone/cli",
  "version": "0.1.0",
  "description": "Command line tools for Oxitone rendering and diagnostics",
  "license": "Apache-2.0",
  "type": "module",
  "bin": { "oxitone": "dist/index.js" },
  "exports": { ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" } },
  "files": ["dist"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "@oxitone/core": "workspace:*",
    "@oxitone/protocol": "workspace:*",
    "@oxitone/native": "workspace:*"
  },
  "devDependencies": { "typescript": "^5.7.0", "vitest": "^3.2.0" }
}
