{
  "name": "@oxitone/native",
  "version": "0.1.0",
  "description": "Oxitone public facade: loads the native engine addon and exposes the typed authoring API",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm --filter @oxitone/native-generated run build && tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxitone/native-generated": "workspace:*",
    "@oxitone/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
