{
  "name": "@oxitone/samples",
  "version": "0.1.0",
  "description": "Rust-backed sample inspection and asset import facade for Oxitone",
  "license": "MPL-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@oxitone/protocol": "workspace:*",
    "@oxitone/native": "workspace:*"
  },
  "devDependencies": {
    "@oxitone/core": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
