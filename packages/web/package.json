{
  "name": "@oxitone/web",
  "version": "0.1.0",
  "description": "Shared Oxitone Rust engine for Wasm runtimes and Web Audio",
  "type": "module",
  "license": "MPL-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./worker": "./dist/worker.js",
    "./worklet": "./dist/worklet.js",
    "./oxitone.wasm": "./dist/oxitone.wasm"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "prepack": "pnpm build && node ../../scripts/build-wasm.mjs",
    "build": "vite build",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --no-file-parallelism --testTimeout=30000"
  },
  "dependencies": {
    "@oxitone/core": "workspace:*",
    "@oxitone/protocol": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
