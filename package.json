{
  "name": "oxitone",
  "version": "0.1.0",
  "private": true,
  "description": "Oxitone: TypeScript authoring SDK backed by a Rust realtime audio engine",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "build:native": "pnpm --filter @oxitone/native-generated run build",
    "lint": "pnpm -r --filter './packages/*' run lint",
    "typecheck": "pnpm -r --filter './packages/*' run typecheck",
    "test": "pnpm -r --filter './packages/*' run test",
    "test:rust": "cargo test --workspace",
    "fmt:rust": "cargo fmt --all --check",
    "schemas": "pnpm --filter @oxitone/protocol run generate"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@napi-rs/cli": "^3.9.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.18.0"
  },
  "packageManager": "pnpm@11.11.0"
}
