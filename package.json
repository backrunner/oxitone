{
  "name": "oxitone-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "Oxitone: TypeScript authoring SDK backed by a Rust realtime audio engine",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' --filter './examples/*' run build",
    "build:native": "pnpm --filter @oxitone/native-generated run build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "example:web": "pnpm --filter @oxitone/example-web start",
    "example:songs:wasm": "node scripts/render-wasm-songs.mjs",
    "test:web": "node examples/web/scripts/smoke.mjs && node examples/web/scripts/watch-smoke.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './examples/*' run typecheck",
    "test": "pnpm -r --workspace-concurrency=1 --filter './packages/*' --filter './examples/*' run test",
    "test:rust": "cargo test --workspace",
    "fmt:rust": "cargo fmt --all --check",
    "schemas": "pnpm --filter @oxitone/protocol run generate",
    "example": "pnpm --filter @oxitone/example-offline start",
    "example:drums": "pnpm --filter @oxitone/example-drums start",
    "example:songs:prepare": "pnpm --filter @oxitone/example-drums songs:prepare",
    "example:songs": "pnpm --filter @oxitone/example-drums songs:render",
    "build:preview": "node scripts/build-preview.mjs",
    "install:cli": "pnpm --filter @oxitone/cli... build && node scripts/install-cli.mjs",
    "preview": "node packages/cli/dist/index.js preview"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@napi-rs/cli": "^3.9.1",
    "@types/node": "^24.13.5",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "8.3.0",
    "vite-plugin-dts": "5.1.0"
  },
  "packageManager": "pnpm@12.3.4"
}
